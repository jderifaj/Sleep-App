---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #f7f6f3;
        --card: #ffffff;
        --text: #1f2328;
        --muted: #6b7280;
        --border: #e2e0db;
        --accent: #3f6f5e;
        --accent-text: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #16181a;
          --card: #1f2226;
          --text: #e8e6e1;
          --muted: #9aa0a6;
          --border: #33373c;
          --accent: #5fa389;
          --accent-text: #0c1210;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
      }
      main {
        max-width: 640px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem;
      }
      h1 {
        font-size: 1.5rem;
        margin: 0 0 0.25rem;
      }
      h2 {
        font-size: 1.05rem;
        margin: 0 0 0.75rem;
      }
      textarea,
      input[type='text'],
      input[type='time'],
      input[type='number'] {
        width: 100%;
        font: inherit;
        padding: 0.6rem 0.7rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
      }
      textarea {
        min-height: 6rem;
        resize: vertical;
      }
      label {
        display: block;
        font-size: 0.85rem;
        color: var(--muted);
        margin: 0.75rem 0 0.3rem;
      }
      label:first-of-type {
        margin-top: 0;
      }
      button {
        font: inherit;
        cursor: pointer;
        border: none;
        border-radius: 8px;
        padding: 0.55rem 1rem;
        background: var(--accent);
        color: var(--accent-text);
        font-weight: 600;
      }
      button:disabled {
        opacity: 0.6;
        cursor: default;
      }
      .row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .status {
        font-size: 0.85rem;
        color: var(--muted);
        min-height: 1.2em;
      }
      .status.error {
        color: #c0392b;
      }
      .toggle-group {
        display: flex;
        gap: 0.5rem;
      }
      .toggle-group button {
        flex: 1;
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text);
        font-weight: 500;
      }
      .toggle-group button.active {
        background: var(--accent);
        color: var(--accent-text);
        border-color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
