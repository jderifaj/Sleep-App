---
interface Props {
  date: string;
}
const { date } = Astro.props;
const formatted = new Date(`${date}T00:00:00`).toLocaleDateString(undefined, {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
});
---

<header>
  <h1>Sleep Tracker</h1>
  <p style="color: var(--muted); margin: 0;">{formatted}</p>
</header>
